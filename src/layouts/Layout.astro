---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<html lang="vi" class="!overflow-x-hidden">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="min-h-screen bg-slate-950 text-sky-50 tracking-wide !overflow-x-hidden">
    <header class="fixed top-0 z-[9999] w-screen"><Navbar /></header>
    <main class="pt-28 md:pt-20"><slot /></main>
    <footer class="w-screen overflow-x-hidden"><Footer /></footer>
  </body>
</html>
