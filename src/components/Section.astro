---
type Props = {
  title: string;
  id?: string;
  full_screen?: boolean;
  className?: string;
};
const {
  title = "Chuyên mục",
  id = title.toLowerCase().replaceAll(" ", "-"),
  full_screen = false,
  className = "",
} = Astro.props;
---

<section
  id={id}
  class={`${full_screen ? "min-h-screen" : ""} w-screen !overflow-x-hidden px-4 py-12 md:py-16 ${className}`}
>
  <div class="w-full grid place-items-center">
    <h2 class="text-center text-3xl text-sky-100 md:text-5xl">{`<${title} />`}</h2>
  </div>
  <div class="mx-auto mt-10 w-full max-w-6xl px-1 md:px-4">
    <slot />
  </div>
</section>
