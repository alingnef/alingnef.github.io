---
import { formatVietnameseDate } from "@/lib/date";

type Props = {
  title: string;
  slug: string;
  excerpt: string;
  date: Date;
  tags?: string[];
};

const { title, slug, excerpt, date, tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div
  class="group relative mx-auto flex min-h-72 w-full flex-col overflow-hidden rounded-lg border border-sky-300/25 bg-gradient-to-br from-sky-300/[0.08] to-slate-950/20 shadow-[0_0_40px_rgba(14,165,233,0.06)] transition duration-300 hover:-translate-y-1 hover:border-sky-300/60"
>
  <div
    class="flex items-center justify-between border-b border-sky-300/15 bg-sky-300/[0.06] px-4 py-3"
  >
    <div class="flex space-x-2">
      <div class="h-2.5 w-2.5 rounded-full bg-sky-200"></div>
      <div class="h-2.5 w-2.5 rounded-full bg-sky-400/70"></div>
      <div class="h-2.5 w-2.5 rounded-full bg-blue-700"></div>
    </div>
    <span class="text-xs text-sky-200/60">/writeup</span>
  </div>

  <div class="flex flex-1 flex-col p-6 tracking-wider">
    <a href={`${base}blog/${slug}/`} class="flex h-full flex-col">
      <h2 class="mb-3 text-xl font-medium text-sky-50">
        <span class="mr-2 text-sky-300">❯</span>
        {title}
      </h2>
      <p class="mb-4 text-sm font-medium tracking-widest text-sky-200/80">
        [{formatVietnameseDate(date)}]
      </p>
      <p class="mb-5 line-clamp-2 text-sm font-thin leading-6 text-sky-100/75">
        {excerpt}
      </p>
      {
        tags.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2">
            {tags.slice(0, 3).map((tag) => (
              <span class="border border-sky-300/20 bg-sky-300/[0.08] px-2 py-1 text-xs text-sky-100/80">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
      <p
        class="mt-auto inline-flex items-center font-medium text-sky-200 underline decoration-sky-400/40 underline-offset-8 transition-all group-hover:decoration-sky-200 group-hover:underline-offset-4"
      >
        Đọc bài
        <svg
          class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width={2}
            d="M9 5l7 7-7 7"></path>
        </svg>
      </p>
    </a>
  </div>
</div>
