---
import { SITE_TITLE, NAV_LINKS as links } from "@/consts";

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
---

<nav class="w-full border-b border-sky-300/15 bg-slate-950/85 px-4 py-4 backdrop-blur-md">
  <div
    class="mx-auto grid w-full max-w-6xl grid-cols-1 place-items-center gap-4 md:flex md:justify-between md:px-4"
  >
    <a href={base} aria-label="Trang chủ">
      <div
        id="logo"
        class="grid select-none place-items-center border border-sky-300/70 bg-sky-300 px-3 pb-1 pt-2 leading-none text-slate-950 transition-colors hover:bg-slate-950 hover:text-sky-200"
      >
        {SITE_TITLE}
      </div>
    </a>
    <div class="flex flex-wrap items-center justify-center gap-2 md:pr-5">
      {
        links.map((link) => {
          const href = link.external ? link.href : `${base}${link.href}`;
          const isActive =
            !link.external &&
            link.href === "blog/" &&
            pathname.startsWith(`${base}blog/`);

          return (
            <>
              <a
                class:list={[{ "bg-sky-300 text-slate-950": isActive }]}
                class="max-w-fit px-2 py-1 text-sm text-sky-100 transition-colors hover:bg-sky-200 hover:text-slate-950"
                href={href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                aria-current={isActive ? "page" : undefined}
              >
                <div>{link.title}</div>
              </a>
            </>
          );
        })
      }
    </div>
  </div>
</nav>
